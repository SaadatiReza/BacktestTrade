# Get a free key at https://twelvedata.com/
TWELVE_DATA_API_KEY=your_api_key_here

# Local dev with Postgres (see docker-compose.yml at the repo root):
#   docker compose up -d
#   cd backend && alembic upgrade head
DATABASE_URL=postgresql+psycopg://sp2l:sp2l@localhost:5432/sp2l

# SQLite still works unmodified for a zero-infra quick start (no docker
# needed) -- migrations run the same way via `alembic upgrade head`.
# DATABASE_URL=sqlite:///./sp2l.db
